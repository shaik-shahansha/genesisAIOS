# Genesis OS — Environment Configuration
# Copy this file to .env and adjust values before running.
# cp .env.example .env

# ── AI Model ──────────────────────────────────────────────────────────────────
# gemma4:e4b  — default, effective 4B params, 9.6 GB, best CPU balance
# gemma4:e2b  — lighter alternative, 7.2 GB, for RAM-constrained machines
# gemma3:4b   — Gemma 3 4B if you prefer an older model
# qwen3:1.7b  — very lightweight, good for CPU-only VPS (1.4 GB)
GENESIS_MODEL=gemma4:e4b

# Fallback models tried (in order) if primary model is unavailable
GENESIS_MODEL_FALLBACK=qwen2.5:1.5b,qwen2.5:0.5b

# Ollama endpoint — in Docker this is the service name; change for external Ollama
OLLAMA_BASE_URL=http://ollama:11434

# GPU layers. Set to 0 to force CPU-only, 999 to use full GPU.
OLLAMA_NUM_GPU=999

# ── User / workspace ──────────────────────────────────────────────────────────
# Your name — injected into the AI identity/system prompt
GENESIS_USER_NAME=User

# Absolute or relative path to the folder Genesis can read/write.
GENESIS_WORKSPACE=./workspace

# ── Ports ─────────────────────────────────────────────────────────────────────
GENESIS_PORT=3000
GENESIS_BROWSER_PORT=8080

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Set to false to allow shell/write commands without approval prompts
GENESIS_APPROVAL_MODE=true

# Enable or disable voice (STT/TTS) sidecar
GENESIS_VOICE_ENABLED=true

# Set to false on networks with SSL inspection (e.g. corporate proxies)
GENESIS_ALLOW_INSECURE_TLS=false

# Demo mode — disables destructive tools and limits file access (for public demos)
DEMO_MODE=false

# ── Image generation ──────────────────────────────────────────────────────────
# Options: pollinations (default, no setup) | sd_api (local Stable Diffusion)
GENESIS_IMAGE_PROVIDER=pollinations

# Only used when GENESIS_IMAGE_PROVIDER=sd_api
# GENESIS_SD_API_URL=http://localhost:7860

# ── Memory sidecar (ChromaDB) ─────────────────────────────────────────────────
MEMORY_SERVICE_URL=http://memory:7701
CHROMA_PATH=/data/chroma

# ── Voice sidecar ─────────────────────────────────────────────────────────────
VOICE_SERVICE_URL=http://voice:7702

# Whisper model size: tiny | base | small | medium (larger = more accurate, slower)
WHISPER_MODEL=base

# Kokoro TTS voice — see: https://huggingface.co/hexgrad/Kokoro-82M
KOKORO_VOICE=bf_emma

# ── Browser (Neko / remote Chromium) ─────────────────────────────────────────
GENESIS_BROWSER_ENABLED=true

# ⚠️  Change these passwords before exposing Genesis on a network.
GENESIS_BROWSER_PASSWORD=change-me
GENESIS_BROWSER_ADMIN_PASSWORD=change-me-admin

GENESIS_BROWSER_USERNAME=Genesis User
GENESIS_BROWSER_DEFAULT_URL=https://www.google.com/

# Leave blank for local Docker use. Set to your public/LAN IP for remote access.
GENESIS_BROWSER_PUBLIC_URL=

# Set to your server's LAN or public IP when clients connect from another device.
GENESIS_BROWSER_NAT1TO1=127.0.0.1
GENESIS_BROWSER_WEBRTC_EPR=56000-56100
GENESIS_BROWSER_SCREEN=1600x900@30
